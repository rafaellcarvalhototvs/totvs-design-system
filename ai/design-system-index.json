{
  "name": "TOTVS Design System",
  "version": "2026-08-22",
  "description": "Índice estruturado para agentes de IA consultarem principalmente o estilo das apresentações TOTVS, além de tokens e componentes de suporte.",
  "baseUrl": "https://totvs-design-system-f0e57812.vercel.app/",
  "primaryFocus": "slide-design",
  "sourceOfTruth": {
    "repository": "https://github.com/rafaellcarvalhototvs/totvs-design-system",
    "manifest": "_ds_manifest.json",
    "guidance": "GEMINI.md",
    "readme": "readme.md"
  },
  "consumptionOrder": [
    "GEMINI.md",
    "ai/design-system-index.json",
    "_ds_manifest.json",
    "tokens/*.css",
    "02-componentes/<category>/<Component>.prompt.md",
    "02-componentes/<category>/<Component>.d.ts",
    "02-componentes/<category>/<Component>.jsx",
    "01-fundamentos/",
    "03-slides/",
    "05-ui-kits/"
  ],
  "tokens": [
    { "path": "tokens/colors.css", "role": "cores, gradientes e estados" },
    { "path": "tokens/typography.css", "role": "famílias, pesos, tamanhos e line-height" },
    { "path": "tokens/spacing.css", "role": "ritmo 8pt, raios, containers e controles" },
    { "path": "tokens/effects.css", "role": "sombras, foco, transições e movimento" },
    { "path": "tokens/fonts.css", "role": "fontes TOTVS e arquivos locais" }
  ],
  "slideSystem": {
    "frame": "1280x720",
    "sharedStylesheet": "03-slides/slide.css",
    "catalogPath": "03-slides/",
    "referenceManifest": "_ds_manifest.json",
    "families": [
      {
        "id": "openings-agenda",
        "label": "Abertura e agenda",
        "paths": ["03-slides/01-capa-*.html", "03-slides/02-abertura-*.html", "03-slides/03-agenda-*.html"],
        "count": 10,
        "examples": ["03-slides/01-capa-01-navy.html", "03-slides/02-abertura-03-divisoria-secao.html", "03-slides/03-agenda-01.html"]
      },
      {
        "id": "content-highlights",
        "label": "Conteúdo e destaques",
        "paths": ["03-slides/04-conteudo-*.html", "03-slides/05-destaque-*.html"],
        "count": 12,
        "examples": ["03-slides/04-conteudo-01-topicos.html", "03-slides/04-conteudo-06-texto-imagem.html", "03-slides/05-destaque-04-foto.html"]
      },
      {
        "id": "process-data",
        "label": "Processos e dados",
        "paths": ["03-slides/06-processo-*.html", "03-slides/07-dados-*.html"],
        "count": 14,
        "examples": ["03-slides/06-processo-01-passo-a-passo.html", "03-slides/06-processo-04-timeline-2.html", "03-slides/07-dados-06-bignumbers-donut.html"]
      },
      {
        "id": "backgrounds-closing",
        "label": "Fundos e fechamento",
        "paths": ["03-slides/08-fundo-*.html", "03-slides/09-fechamento-*.html"],
        "count": 9,
        "examples": ["03-slides/08-fundo-01-azul-escuro.html", "03-slides/09-fechamento-01-frase-impacto.html", "03-slides/09-fechamento-04-contracapa.html"]
      }
    ],
    "compositionRules": [
      "Começar por um slide existente da mesma família.",
      "Manter o frame 1280x720, o pagemark, o número de página e a assinatura TOTVS.",
      "Usar o grafismo 3D O como elemento de composição, não como decoração aleatória.",
      "Preservar recortes grandes, painéis, hierarquia e áreas de respiro da referência.",
      "Em slides, respeitar a tipografia Verdana escopada em 03-slides/slide.css."
    ]
  },
  "brandDefaults": {
    "navy": "#002233",
    "cyan": "#00DBFF",
    "white": "#FFFFFF",
    "displayFont": "TOTVS",
    "bodyFont": "Verdana",
    "spacingRhythm": "8pt"
  },
  "supportComponents": [
    { "name": "Avatar", "category": "core", "path": "02-componentes/core/Avatar" },
    { "name": "Badge", "category": "core", "path": "02-componentes/core/Badge" },
    { "name": "Button", "category": "core", "path": "02-componentes/core/Button" },
    { "name": "Card", "category": "core", "path": "02-componentes/core/Card" },
    { "name": "Alert", "category": "feedback", "path": "02-componentes/feedback/Alert" },
    { "name": "ProgressBar", "category": "feedback", "path": "02-componentes/feedback/ProgressBar" },
    { "name": "Checkbox", "category": "forms", "path": "02-componentes/forms/Checkbox" },
    { "name": "Input", "category": "forms", "path": "02-componentes/forms/Input" },
    { "name": "Switch", "category": "forms", "path": "02-componentes/forms/Switch" },
    { "name": "Tabs", "category": "navigation", "path": "02-componentes/navigation/Tabs" }
  ],
  "componentFileConvention": {
    "prompt": "<path>.prompt.md",
    "api": "<path>.d.ts",
    "implementation": "<path>.jsx"
  },
  "startingPoints": [
    {
      "name": "Slide de referência",
      "path": "03-slides/01-capa-01-navy.html",
      "kind": "slide",
      "viewport": "1280x720"
    },
    {
      "name": "TOTVS Gestão UI Kit",
      "path": "05-ui-kits/gestao/index.html",
      "flow": "Login → Dashboard → Pedidos",
      "viewport": "1280x720",
      "status": "composição demonstrativa, não especificação de produto"
    }
  ],
  "visualFoundations": {
    "path": "01-fundamentos/",
    "topics": [
      "marca",
      "logo",
      "arquitetura de marcas",
      "cores",
      "tipografia",
      "grafismo",
      "fotografia",
      "iconografia",
      "aplicações",
      "espaçamento e elevação"
    ]
  },
  "runtime": {
    "type": "static-html",
    "bundle": "_ds_bundle.js",
    "namespace": "TOTVSDesignSystem_be3538",
    "localCommand": "python3 -m http.server 8080"
  },
  "agentInstruction": "Antes de criar uma apresentação, escolha uma família de slide e procure primeiro uma composição existente em 03-slides/. Reutilize o slide de referência, seus tokens e assets; não invente valores de marca sem registrar a lacuna."
}
